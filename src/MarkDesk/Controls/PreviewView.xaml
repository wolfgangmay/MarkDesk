<UserControl x:Class="MarkDesk.Controls.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="{DynamicResource WindowBgBrush}">
        <wv2:WebView2 x:Name="WebView" PreviewMouseWheel="WebView_PreviewMouseWheel" />
        <TextBlock x:Name="LoadingHint"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.4" FontSize="14"
                   Text="Preparing preview…" />
        <!-- Offscreen WebView2 used exclusively for PDF export, so exporting a
             light-themed document never disturbs the on-screen preview.
             Created on demand per export and disposed afterwards (#1). -->
        <Grid x:Name="PrintHost" Visibility="Hidden" Width="0" Height="0"
              HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</UserControl>
