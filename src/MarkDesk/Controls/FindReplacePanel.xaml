<UserControl x:Class="MarkDesk.Controls.FindReplacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ContentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionTextBrush" Value="{DynamicResource WindowBgBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ToneBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ToneBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource BarBgBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6"
            Padding="10" Width="400" Margin="10,10,10,0"
            HorizontalAlignment="Right" VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.25" ShadowDepth="2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" HorizontalAlignment="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                    FontSize="12" Width="24" Height="24" Margin="0,0,0,6"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource ContentBrush}"
                    Click="Close_Click" ToolTip="Close (Esc)" />

            <TextBox Grid.Row="1" x:Name="FindBox" Margin="0,0,0,6"
                     KeyDown="Input_KeyDown" TextChanged="FindBox_TextChanged" />

            <TextBox Grid.Row="2" x:Name="ReplaceBox" Margin="0,0,0,6" KeyDown="Input_KeyDown" />

            <WrapPanel Grid.Row="3" Margin="0,0,0,4">
                <ToggleButton x:Name="MatchCase" Content="Aa" Width="34" Margin="0,0,4,0"
                              ToolTip="Match case" />
                <ToggleButton x:Name="WholeWords" Content="W" Width="34" Margin="0,0,8,0"
                              ToolTip="Whole words" />
                <Button Content="Prev" Click="Prev_Click" Margin="0,0,4,0" Padding="10,2" />
                <Button Content="Next" Click="Next_Click" Margin="0,0,4,0" Padding="10,2" />
                <Button x:Name="ReplaceBtn" Content="Replace" Click="Replace_Click"
                        Margin="0,0,4,0" Padding="10,2" />
                <Button x:Name="ReplaceAllBtn" Content="Replace All" Click="ReplaceAll_Click"
                        Padding="10,2" />
            </WrapPanel>

            <TextBlock Grid.Row="4" x:Name="Status" Text="" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
        </Grid>
    </Border>
</UserControl>
