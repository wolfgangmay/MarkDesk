<Window x:Class="MarkDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MarkDesk"
        xmlns:vm="clr-namespace:MarkDesk.ViewModels"
        xmlns:models="clr-namespace:MarkDesk.Models"
        xmlns:conv="clr-namespace:MarkDesk.Converters"
        xmlns:controls="clr-namespace:MarkDesk.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}" Icon="/Assets/App.ico"
        Background="{DynamicResource WindowBgBrush}"
        Height="650" Width="1100"
        AllowDrop="True" Drop="Window_Drop" PreviewDragOver="Window_PreviewDragOver"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumBool" />

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="New_Executed" />
        <CommandBinding Command="Open" Executed="Open_Executed" />
        <CommandBinding Command="Save" Executed="Save_Executed" />
        <CommandBinding Command="SaveAs" Executed="SaveAs_Executed" />
        <CommandBinding Command="Print" Executed="ExportPdf_Executed" />
        <CommandBinding Command="Close" Executed="Exit_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.CycleViewModeCommand}" Executed="CycleViewMode_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="Find_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Replace}" Executed="Replace_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F6" Command="{x:Static local:MainWindow.CycleViewModeCommand}" />
        <KeyBinding Modifiers="Control" Key="N" Command="New" />
        <KeyBinding Modifiers="Control" Key="O" Command="Open" />
        <KeyBinding Modifiers="Control" Key="S" Command="Save" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="SaveAs" />
        <KeyBinding Modifiers="Control" Key="P" Command="Print" />
        <KeyBinding Modifiers="Control" Key="F" Command="{x:Static ApplicationCommands.Find}" />
        <KeyBinding Modifiers="Control" Key="H" Command="{x:Static ApplicationCommands.Replace}" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BarBgBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel Height="46">
                <Menu x:Name="MainMenu" DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center"
                      Foreground="{DynamicResource ContentBrush}">
                    <Menu.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
                            <Setter Property="Padding" Value="14,4" />
                            <Setter Property="ItemContainerStyle">
                                <Setter.Value>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
                                        <Setter Property="Padding" Value="14,4" />
                                    </Style>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Menu.ItemContainerStyle>
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="New" />
                        <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Command="Open" />
                        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="Save" />
                        <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Command="SaveAs" />
                        <Separator />
                        <MenuItem Header="Recent" x:Name="RecentMenu" SubmenuOpened="Recent_SubmenuOpened" />
                        <Separator />
                        <MenuItem Header="Export as _PDF…" InputGestureText="Ctrl+P" Command="Print" />
                        <Separator />
                        <MenuItem Header="E_xit" Command="Close" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Find…" Command="{x:Static ApplicationCommands.Find}" />
                        <MenuItem Header="_Replace…" Command="{x:Static ApplicationCommands.Replace}" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="_Edit" IsCheckable="True" IsChecked="{Binding IsEditActive, Mode=TwoWay}" />
                        <MenuItem Header="_Split" IsCheckable="True" IsChecked="{Binding IsSplitActive, Mode=TwoWay}" />
                        <MenuItem Header="_Preview" IsCheckable="True" IsChecked="{Binding IsPreviewActive, Mode=TwoWay}" />
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="_Theme">
                            <MenuItem Header="System" IsCheckable="True"
                                      IsChecked="{Binding ThemeMode, Converter={StaticResource EnumBool}, ConverterParameter={x:Static models:ThemeMode.System}, Mode=TwoWay}" />
                            <MenuItem Header="Light" IsCheckable="True"
                                      IsChecked="{Binding ThemeMode, Converter={StaticResource EnumBool}, ConverterParameter={x:Static models:ThemeMode.Light}, Mode=TwoWay}" />
                            <MenuItem Header="Dark" IsCheckable="True"
                                      IsChecked="{Binding ThemeMode, Converter={StaticResource EnumBool}, ConverterParameter={x:Static models:ThemeMode.Dark}, Mode=TwoWay}" />
                        </MenuItem>
                        <MenuItem Header="_Settings…" Click="Settings_Click" />
                        <Separator />
                        <MenuItem Header="Set as _Default for .md…" Click="SetDefaultApp_Click" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="About MarkDesk" Click="About_Click" />
                    </MenuItem>
                </Menu>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="8,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" Command="New"
                            ToolTip="New (Ctrl+N)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Command="Open"
                            ToolTip="Open… (Ctrl+O)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Command="Save"
                            ToolTip="Save (Ctrl+S)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE792;" Command="SaveAs"
                            ToolTip="Save As… (Ctrl+Shift+S)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE71B;" Command="Print"
                            ToolTip="Export as PDF… (Ctrl+P)" />

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource DividerBrush}" Margin="10,0" />

                    <Border Background="{DynamicResource ToneBgBrush}" CornerRadius="7" Padding="3,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentItem}" Content="Edit" GroupName="ViewMode"
                                         IsChecked="{Binding IsEditActive, Mode=TwoWay}"
                                         ToolTip="Editor only" />
                            <RadioButton Style="{StaticResource SegmentItem}" Content="Split" GroupName="ViewMode"
                                         IsChecked="{Binding IsSplitActive, Mode=TwoWay}"
                                         ToolTip="Editor and preview side by side" />
                            <RadioButton Style="{StaticResource SegmentItem}" Content="Preview" GroupName="ViewMode"
                                         IsChecked="{Binding IsPreviewActive, Mode=TwoWay}"
                                         ToolTip="Preview only" />
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource DividerBrush}" Margin="10,0" />

                    <ToggleButton Style="{StaticResource SegmentToggle}" Content="Wrap"
                                  IsChecked="{Binding WordWrap, ElementName=Editor, Mode=TwoWay}"
                                  ToolTip="Toggle line wrapping" />

                    <Rectangle Width="1" Height="22" Fill="{DynamicResource DividerBrush}" Margin="10,0" />

                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click"
                            ToolTip="Settings" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE790;" Click="ThemeToggle_Click"
                            ToolTip="Toggle light/dark theme" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource BarBgBrush}"
                   BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Ln " /><Run Text="{Binding CaretLine}" />
                    <Run Text=", Col " /><Run Text="{Binding CaretColumn}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding Encoding}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding WordCount}" /><Run Text=" words" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="ZoomLabel" Text="100%" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="PreviewStatus" Text="Preview: idle" Foreground="{DynamicResource MutedBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="6,3">
                <ToggleButton x:Name="TabEdit" Style="{StaticResource SegmentToggle}" Content="Edit"
                              Margin="0,0,4,0" Click="TabEdit_Click" />
                <ToggleButton x:Name="TabPreview" Style="{StaticResource SegmentToggle}" Content="Preview"
                              Click="TabPreview_Click" />
            </StackPanel>

            <Grid x:Name="SplitGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorCol" Width="*" />
                    <ColumnDefinition x:Name="SplitterCol" Width="Auto" />
                    <ColumnDefinition x:Name="PreviewCol" Width="*" />
                </Grid.ColumnDefinitions>
                <controls:MarkdownEditor x:Name="Editor" Grid.Column="0"
                                         DocumentText="{Binding DocumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                <controls:PreviewView x:Name="Preview" Grid.Column="2" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
