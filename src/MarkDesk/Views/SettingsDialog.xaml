<Window x:Class="MarkDesk.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MarkDesk.Models"
        xmlns:vm="clr-namespace:MarkDesk.ViewModels"
        xmlns:s="clr-namespace:System;assembly=System.Runtime"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" Width="520" MinWidth="480" MinHeight="320"
        SizeToContent="Height" MaxHeight="760"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="16" TextElement.Foreground="{DynamicResource ContentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Layout -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Layout" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Split view width threshold (px):"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,12,0,0">
                    <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding LayoutThresholdPx, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock FontSize="11" Opacity="0.7" Margin="0,4,0,0"
                               Text="{Binding CurrentWindowWidth, StringFormat=Current window width: \{0\} px}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Default view mode:"
                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ThemedComboBox}" Margin="0,12,0,0"
                          ItemsSource="{Binding ViewModes}" SelectedItem="{Binding DefaultViewMode}"/>

                <!-- Images -->
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Images" FontWeight="Bold" Margin="0,24,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Assets folder name:"
                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ThemedTextBox}" Margin="0,12,0,0"
                         Text="{Binding AssetsFolderName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Image name pattern:"
                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ThemedTextBox}" Margin="0,12,0,0"
                         Text="{Binding ImageNamePattern, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Editor & PDF -->
                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Editor &amp; PDF" FontWeight="Bold" Margin="0,24,0,10"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Scroll sync:"
                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                <CheckBox Grid.Row="7" Grid.Column="1" Style="{StaticResource ThemedCheckBox}"
                          IsChecked="{Binding ScrollSync}" Margin="0,12,0,0"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Render debounce (ms):"
                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ThemedTextBox}" Margin="0,12,0,0"
                         Text="{Binding RenderDebounceMs, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="PDF page size:"
                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                <ComboBox Grid.Row="9" Grid.Column="1" Style="{StaticResource ThemedComboBox}" Margin="0,12,0,0"
                          ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PdfPageSize}"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="PDF margins (mm):"
                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                <Grid Grid.Row="10" Grid.Column="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ThemedTextBox}" Margin="0,0,6,0"
                             Text="{Binding PdfMarginTopMm, UpdateSourceTrigger=PropertyChanged}" ToolTip="Top (5-40)"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ThemedTextBox}" Margin="0,0,6,0"
                             Text="{Binding PdfMarginBottomMm, UpdateSourceTrigger=PropertyChanged}" ToolTip="Bottom (5-40)"/>
                    <TextBox Grid.Column="2" Style="{StaticResource ThemedTextBox}" Margin="0,0,6,0"
                             Text="{Binding PdfMarginLeftMm, UpdateSourceTrigger=PropertyChanged}" ToolTip="Left (5-40)"/>
                    <TextBox Grid.Column="3" Style="{StaticResource ThemedTextBox}"
                             Text="{Binding PdfMarginRightMm, UpdateSourceTrigger=PropertyChanged}" ToolTip="Right (5-40)"/>
                </Grid>
                <TextBlock Grid.Row="11" Grid.Column="1" FontSize="11" Opacity="0.7" Margin="0,4,0,0"
                           Text="Top / Bottom / Left / Right (each 5-40 mm)"/>

                <!-- Appearance -->
                <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Text="Appearance" FontWeight="Bold" Margin="0,24,0,10"/>

                <TextBlock Grid.Row="13" Grid.Column="0" Text="Theme:"
                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                <ComboBox Grid.Row="13" Grid.Column="1" Style="{StaticResource ThemedComboBox}" Margin="0,12,0,0"
                          ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource ThemedButton}" Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource ThemedAccentButton}" Content="OK" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
