<Window x:Class="MarkDesk.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MarkDesk.Models"
        xmlns:vm="clr-namespace:MarkDesk.ViewModels"
        xmlns:s="clr-namespace:System;assembly=System.Runtime"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" Height="500" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Layout" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Split view width threshold (px):" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
                <TextBox Text="{Binding LayoutThresholdPx, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
                <TextBlock FontSize="11" Opacity="0.7"
                           Text="{Binding CurrentWindowWidth, StringFormat=Current window width: \{0\} px}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Default view mode:" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                      ItemsSource="{Binding ViewModes}" SelectedItem="{Binding DefaultViewMode}"/>

            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Images" FontWeight="Bold" Margin="0,16,0,8"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Assets folder name:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AssetsFolderName, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Image name pattern:" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,8,0,0"
                     Text="{Binding ImageNamePattern, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Editor &amp; PDF" FontWeight="Bold" Margin="0,16,0,8"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Scroll sync:" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding ScrollSync}"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Render debounce (ms):" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Text="{Binding RenderDebounceMs, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="PDF page size:" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,8,0,0"
                      ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PdfPageSize}"/>

            <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Text="Appearance" FontWeight="Bold" Margin="0,16,0,8"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Theme:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="11" Grid.Column="1"
                      ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="16,4" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="OK" Padding="16,4" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
