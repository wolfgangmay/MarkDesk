<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent single-file profile (NFR-04 / §8 mitigation).
  Small exe (meets <=30 MB NFR-03) at the cost of requiring the
  .NET 10 Desktop runtime (and system WebView2 runtime) to be installed.

  The self-contained Portable.pubxml (73 MB, no prerequisites) stays
  available for a true "green" build; MSIX is deferred pending a signing
  certificate (§8).
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\portable-framework</PublishDir>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <ReadyToRun>true</ReadyToRun>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
