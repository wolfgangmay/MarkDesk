<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable single-file publish profile (NFR-04).
  - Self-contained: green exe, no .NET install prerequisite
  - PublishSingleFile: one MarkDesk.exe
  - ReadyToRun: faster startup (§4.4-1)
  - IncludeNativeLibrariesForSelfExtract: native libs inside the bundle
  - Trimming DISABLED: WPF is not trim-safe (§8 risk row)

  Note: self-contained WPF single-file is large; size target ≤30 MB (NFR-03)
  is verified in Phase 4. If exceeded, switch primary distribution to MSIX
  (§8 mitigation) and keep this as a fallback.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\portable</PublishDir>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <ReadyToRun>true</ReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
